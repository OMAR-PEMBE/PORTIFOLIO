# Required: the mailbox that receives portfolio enquiries. A Gmail address is supported.
CONTACT_RECIPIENT=

# Required: a bare sender email. For testing without a domain, use onboarding@resend.dev.
CONTACT_FROM=

# Required: create a restricted sending key in the Resend dashboard.
RESEND_API_KEY=

# Database connection used by db_connect.php.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_db

# Optional shared contact rate limiter for multi-server deployments.
REDIS_DSN=

# Optional durable outbox directory. Run scripts/process-contact-queue.php from cron.
CONTACT_QUEUE_DIR=

# Optional writable storage locations. Point these at a Render persistent disk in production.
APP_DATA_DIR=
UPLOAD_STORAGE_DIR=

# Required for /admin/. Generate a unique value with: php -r "echo password_hash('choose-a-long-unique-password', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=
ADMIN_USERNAME=admin
