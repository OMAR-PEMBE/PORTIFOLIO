# Required: the mailbox that receives portfolio enquiries. A Gmail address is supported.
CONTACT_RECIPIENT=

# Required: a sender mailbox on a domain verified with Resend.
CONTACT_FROM=

# Required: create a restricted sending key in the Resend dashboard.
RESEND_API_KEY=

# Database connection used by db_connect.php.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=portfolio_db

# Optional shared contact rate limiter for multi-server deployments.
REDIS_DSN=

# Optional durable outbox directory. Run scripts/process-contact-queue.php from cron.
CONTACT_QUEUE_DIR=

# Required for /admin/. Generate with: php -r "echo password_hash('replace-me', PASSWORD_DEFAULT), PHP_EOL;"
ADMIN_PASSWORD_HASH=$2y$10$NY8xfIZjEy/4kWjJxE.6A.TkYeJD8xUHNZRnp7M4DWBu.q13iZftu
ADMIN_USERNAME=admin
